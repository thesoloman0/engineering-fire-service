---
const items = [
  'Fire Fighting System','Fire Suppression System','Fire Alarm System',
  'Hydrant System','Sprinkler System','Smoke Detector',
  'Extinguisher Refilling','Emergency Evacuation Plan',
  'Fire Awareness Training','Fire Drills',
];
---
<div class="marquee-strip" aria-hidden="true">
  <div class="marquee-track">
    {[...items, ...items].map(item => (
      <span class="marquee-item">🔥 {item}</span>
    ))}
  </div>
</div>

<style>
.marquee-strip {
  background: var(--red);
  border-top: 2px solid var(--red-dark);
  border-bottom: 2px solid var(--red-dark);
  padding-block: 13px;
  overflow: hidden;
}
.marquee-track {
  display: flex; white-space: nowrap;
  animation: marquee 30s linear infinite;
}
.marquee-item {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: .82rem; font-weight: 700;
  letter-spacing: .2em; text-transform: uppercase;
  color: #fff; padding-inline: 36px;
}
@keyframes marquee {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}
@media (prefers-reduced-motion: reduce) {
  .marquee-track { animation: none; }
}
</style>
