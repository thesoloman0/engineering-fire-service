<section id="contact" class="contact-section">
  <div class="container">
    <div class="section-tag">Get In Touch</div>
    <h2 class="section-title">CONTACT <span class="accent">US</span></h2>
    <div class="divider"></div>

    <div class="contact-grid reveal">
      <!-- Info -->
      <div class="contact-info">
        <div class="info-block">
          <span class="info-label">📍 Address</span>
          <p class="info-value">
            H-12, Vijay Vihar Colony,<br />
            Behind RPS Law College, Danapur,<br />
            Patna – 801503, Bihar
          </p>
        </div>
        <div class="info-block">
          <span class="info-label">📞 Mobile</span>
          <p class="info-value">
            <a href="tel:9798750732">+91 97987 50732</a><br />
            <a href="tel:7050800190">+91 70508 00190</a>
          </p>
        </div>
        <div class="info-block">
          <span class="info-label">✉️ Email</span>
          <p class="info-value">
            <a href="mailto:engineeringfireservice@gmail.com" class="email-link">
              engineeringfireservice@gmail.com
            </a>
          </p>
        </div>
        <div class="info-block">
          <span class="info-label">🏛️ GSTIN</span>
          <p class="info-value gstin">10AAGFE0681H1ZW</p>
        </div>
        <div class="info-block">
          <span class="info-label">🕐 Service Hours</span>
          <p class="info-value">24 × 7 — Always Available</p>
        </div>

        <a href="https://wa.me/919798750732" target="_blank" rel="noopener" class="wa-direct btn btn-primary">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Chat on WhatsApp
        </a>
      </div>

      <!-- Form -->
      <div class="contact-form">
        <div class="form-row">
          <div class="form-field">
            <label for="cf-name">Your Name</label>
            <input id="cf-name" type="text" placeholder="Full Name" autocomplete="name" />
          </div>
          <div class="form-field">
            <label for="cf-phone">Phone Number</label>
            <input id="cf-phone" type="tel" placeholder="+91 XXXXX XXXXX" autocomplete="tel" />
          </div>
        </div>
        <div class="form-field">
          <label for="cf-email">Email Address</label>
          <input id="cf-email" type="email" placeholder="you@example.com" autocomplete="email" />
        </div>
        <div class="form-field">
          <label for="cf-service">Service Required</label>
          <select id="cf-service">
            <option value="">— Select a Service —</option>
            <option>Fire Extinguisher Supply</option>
            <option>Fire Alarm System</option>
            <option>Sprinkler / Hydrant System</option>
            <option>Fire Suppression System</option>
            <option>Refilling &amp; Maintenance</option>
            <option>Emergency Evacuation Plan</option>
            <option>Fire Safety Training</option>
            <option>Other</option>
          </select>
        </div>
        <div class="form-field">
          <label for="cf-msg">Message</label>
          <textarea id="cf-msg" rows="4" placeholder="Describe your requirement or project details..."></textarea>
        </div>
        <button class="btn btn-primary submit-btn" id="wa-submit" type="button">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Send via WhatsApp
        </button>
      </div>
    </div>
  </div>
</section>

<style>
.contact-section {
  background: var(--charcoal);
  padding-block: clamp(60px, 10vh, 100px);
}
.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 72px;
  align-items: start;
}
.contact-info { display: flex; flex-direction: column; gap: 26px; }
.info-block { display: flex; flex-direction: column; gap: 6px; }
.info-label {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: .72rem; font-weight: 700;
  letter-spacing: .2em; text-transform: uppercase;
  color: var(--red);
}
.info-value { font-size: 1rem; color: var(--white); line-height: 1.65; }
.info-value a { color: var(--white); transition: color .2s; }
.info-value a:hover { color: var(--red); }
.email-link { color: var(--red) !important; word-break: break-all; }
.gstin {
  font-family: 'Barlow Condensed', sans-serif;
  letter-spacing: .1em; font-size: 1rem;
}
.wa-direct { gap: 10px; margin-top: 8px; }

/* Form */
.contact-form { display: flex; flex-direction: column; gap: 16px; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.form-field { display: flex; flex-direction: column; gap: 6px; }
.form-field label {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: .73rem; font-weight: 700;
  letter-spacing: .16em; text-transform: uppercase;
  color: var(--silver);
}
.form-field input,
.form-field textarea,
.form-field select {
  background: var(--steel);
  border: 1px solid rgba(255,255,255,.08);
  color: var(--white);
  padding: 12px 14px;
  font-family: 'Barlow', sans-serif;
  font-size: .95rem;
  border-radius: 2px;
  outline: none;
  transition: border-color .2s;
  width: 100%;
}
.form-field input:focus,
.form-field textarea:focus,
.form-field select:focus { border-color: var(--red); }
.form-field select option { background: var(--steel); }
.form-field textarea { resize: vertical; min-height: 110px; }
.submit-btn { align-self: flex-start; gap: 10px; }

@media (max-width: 860px) {
  .contact-grid { grid-template-columns: 1fr; gap: 48px; }
}
@media (max-width: 500px) {
  .form-row { grid-template-columns: 1fr; }
}
</style>

<script>
  document.getElementById('wa-submit')!.addEventListener('click', () => {
    const name    = (document.getElementById('cf-name')    as HTMLInputElement).value.trim();
    const phone   = (document.getElementById('cf-phone')   as HTMLInputElement).value.trim();
    const email   = (document.getElementById('cf-email')   as HTMLInputElement).value.trim();
    const service = (document.getElementById('cf-service') as HTMLSelectElement).value;
    const msg     = (document.getElementById('cf-msg')     as HTMLTextAreaElement).value.trim();

    if (!name || !phone) {
      alert('Please enter at least your Name and Phone Number.');
      return;
    }

    const lines = [
      '🔥 *New Enquiry – Engineering Fire Service Corporation*',
      '',
      `👤 *Name:* ${name}`,
      `📞 *Phone:* ${phone}`,
      email   ? `✉️ *Email:* ${email}`    : '',
      service ? `🛠️ *Service:* ${service}` : '',
      msg     ? `💬 *Message:* ${msg}`    : '',
    ].filter(Boolean).join('\n');

    window.open(`https://wa.me/919798750732?text=${encodeURIComponent(lines)}`, '_blank');
  });
</script>
