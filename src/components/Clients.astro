---

<section id="clients" class="clients-section">
  <div class="container">
    <div class="section-tag">Our Track Record</div>
    <h2 class="section-title">PROJECTS <span class="accent">COMPLETED</span></h2>
    <div class="divider"></div>
    <p class="clients-intro reveal">
      We have successfully installed fire protection systems across 52+ buildings, hospitals,
      hotels, schools, and residential complexes in Bihar and Jharkhand.
    </p>

    <div class="tables-grid reveal">
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th class="sl-col">SL</th><th>Organisation</th><th>Location</th></tr>
          </thead>
          <tbody>
            {col1.map(c => (
              <tr>
                <td class="sl-col">{c.sl}</td>
                <td>{c.name}</td>
                <td class="loc">{c.location}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr><th class="sl-col">SL</th><th>Organisation</th><th>Location</th></tr>
          </thead>
          <tbody>
            {col2.map(c => (
              <tr>
                <td class="sl-col">{c.sl}</td>
                <td>{c.name}</td>
                <td class="loc">{c.location}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<style>
.clients-section {
  background: var(--black);
  padding-block: clamp(60px, 10vh, 100px);
}
.clients-intro {
  max-width: 600px;
  font-size: 1rem; color: var(--silver); line-height: 1.75;
  margin-bottom: 48px;
}
.tables-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}
.table-wrap {
  border: 1px solid var(--steel);
  overflow: hidden;
  overflow-x: auto;
}
table {
  width: 100%; border-collapse: collapse;
  min-width: 340px;
}
thead tr { background: var(--red); }
thead th {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: .78rem; font-weight: 700;
  letter-spacing: .15em; text-transform: uppercase;
  color: #fff; padding: 12px 16px; text-align: left;
  white-space: nowrap;
}
tbody tr {
  border-bottom: 1px solid rgba(255,255,255,.04);
  transition: background .15s;
}
tbody tr:hover { background: rgba(200,21,27,.07); }
tbody td {
  padding: 10px 16px;
  font-size: .86rem; color: #ccc;
}
.sl-col {
  color: var(--red) !important;
  font-weight: 700; width: 44px;
  font-family: 'Barlow Condensed', sans-serif;
  font-size: .9rem !important;
}
.loc { color: var(--silver) !important; white-space: nowrap; }

@media (max-width: 860px) {
  .tables-grid { grid-template-columns: 1fr; }
}
</style>
