---
const services = [
  'Fire Suppression System','Fire Alarm System','Hydrant & Sprinkler',
  'Extinguisher Supply','Refilling & Maintenance','Emergency Planning',
];
const links = [
  { href:'#about',    label:'About Us'       },
  { href:'#products', label:'Products'       },
  { href:'#clients',  label:'Our Clients'    },
  { href:'#why',      label:'Why Choose Us'  },
  { href:'#contact',  label:'Contact'        },
];
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand-col">
      <p class="footer-logo">ENGINEERING <span>FIRE SERVICE</span> CORPORATION</p>
      <p class="footer-tagline">
        Deals in all types of extinguisher, refilling &amp; fire controlling systems
        such as Hydrant, Sprinklers, Fire Alarm, Smoke Detector systems and more.
        Bihar's trusted fire safety partner since 2016.
      </p>
      <p class="footer-contact-line">
        <a href="tel:9798750732">+91 97987 50732</a> &nbsp;|&nbsp;
        <a href="tel:7050800190">+91 70508 00190</a>
      </p>
      <p class="footer-contact-line">
        <a href="mailto:engineeringfireservice@gmail.com">engineeringfireservice@gmail.com</a>
      </p>
    </div>

    <div class="footer-col">
      <h3 class="footer-col-title">Services</h3>
      <ul>
        {services.map(s => <li><a href="#services">{s}</a></li>)}
      </ul>
    </div>

    <div class="footer-col">
      <h3 class="footer-col-title">Quick Links</h3>
      <ul>
        {links.map(l => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <span class="copy">© {new Date().getFullYear()} Engineering Fire Service Corporation. All rights reserved.</span>
      <span class="gstin">GSTIN: <strong>10AAGFE0681H1ZW</strong></span>
    </div>
  </div>
</footer>

<!-- WhatsApp FAB -->
<a
  href="https://wa.me/919798750732"
  target="_blank"
  rel="noopener"
  class="wa-fab"
  aria-label="Chat on WhatsApp"
>
  <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
  </svg>
</a>

<style>
.footer {
  background: #050505;
  border-top: 1px solid var(--steel);
}
.footer-inner {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 56px;
  padding-block: 56px 40px;
  border-bottom: 1px solid var(--steel);
}
.footer-logo {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1.65rem; letter-spacing: .05em;
  color: var(--white); margin-bottom: 14px;
}
.footer-logo span { color: var(--red); }
.footer-tagline { font-size: .84rem; color: var(--silver); line-height: 1.7; max-width: 320px; margin-bottom: 16px; }
.footer-contact-line { font-size: .86rem; margin-bottom: 4px; }
.footer-contact-line a { color: var(--silver); transition: color .2s; }
.footer-contact-line a:hover { color: var(--white); }

.footer-col-title {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: .75rem; font-weight: 700;
  letter-spacing: .22em; text-transform: uppercase;
  color: var(--red); margin-bottom: 18px;
}
.footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
.footer-col ul li a {
  font-size: .87rem; color: var(--silver);
  transition: color .2s;
}
.footer-col ul li a:hover { color: var(--white); }

.footer-bottom { padding-block: 22px; }
.footer-bottom-inner {
  display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;
}
.copy { font-size: .78rem; color: var(--ash); }
.gstin { font-family: 'Barlow Condensed', sans-serif; font-size: .78rem; letter-spacing: .08em; color: var(--ash); }
.gstin strong { color: var(--silver); }

/* WhatsApp FAB */
.wa-fab {
  position: fixed; bottom: 26px; right: 26px; z-index: 200;
  width: 56px; height: 56px; border-radius: 50%;
  background: #25D366;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4px 20px rgba(37,211,102,.45);
  transition: transform .25s, box-shadow .25s;
  color: #fff;
}
.wa-fab:hover {
  transform: scale(1.12);
  box-shadow: 0 6px 28px rgba(37,211,102,.6);
}

@media (max-width: 860px) {
  .footer-inner { grid-template-columns: 1fr 1fr; }
  .footer-brand-col { grid-column: 1 / -1; }
}
@media (max-width: 500px) {
  .footer-inner { grid-template-columns: 1fr; gap: 32px; }
  .footer-bottom-inner { flex-direction: column; text-align: center; }
}
</style>
