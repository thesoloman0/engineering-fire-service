---
---
<section class="hero" id="home">
  <div class="container hero-inner">
    <div class="hero-content">
      <span class="badge">Est. 2016 · Patna, Bihar · GSTIN: 10AAGFE0681H1ZW</span>
      <h1>
        <span class="fill">PROTECTING</span><br />
        <span class="outline">LIVES &amp;</span><br />
        <span class="fill">PROPERTY</span>
      </h1>
      <p class="hero-sub">
        Bihar's trusted fire safety specialists — supplying, installing, and maintaining
        world-class fire protection systems for buildings, hospitals, and industries since 2016.
      </p>
      <div class="hero-actions">
        <a href="#services" class="btn btn-primary">Our Services</a>
        <a href="#contact" class="btn btn-outline">Get a Quote</a>
      </div>
    </div>

    <div class="hero-stats">
      <div class="stat">
        <span class="stat-num">200<span class="plus">+</span></span>
        <span class="stat-label">Projects Completed</span>
      </div>
      <div class="stat">
        <span class="stat-num">9<span class="plus">+</span></span>
        <span class="stat-label">Years Experience</span>
      </div>
      <div class="stat">
        <span class="stat-num">24<span class="plus">×7</span></span>
        <span class="stat-label">Service Available</span>
      </div>
      <div class="stat">
        <span class="stat-num">50<span class="plus">+</span></span>
        <span class="stat-label">Professionals</span>
      </div>
    </div>
  </div>

  <div class="hero-bg-flame" aria-hidden="true">🔥</div>
</section>

<style>
.hero {
  min-height: 100vh;
  display: flex; flex-direction: column; justify-content: center;
  padding-top: 90px;
  position: relative; overflow: hidden;
  background: linear-gradient(135deg, #0A0A0A 0%, #1a0505 60%, #0A0A0A 100%);
}
.hero::before {
  content: '';
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse 60% 55% at 80% 50%, rgba(200,21,27,.2) 0%, transparent 70%),
    repeating-linear-gradient(90deg, rgba(255,255,255,.015) 0px, rgba(255,255,255,.015) 1px, transparent 1px, transparent 60px),
    repeating-linear-gradient(0deg,  rgba(255,255,255,.015) 0px, rgba(255,255,255,.015) 1px, transparent 1px, transparent 60px);
  pointer-events: none;
}

.hero-inner {
  position: relative; z-index: 1;
  display: flex; flex-direction: column;
  padding-block: clamp(40px, 8vh, 80px);
  gap: 60px;
}

/* Badge */
.badge {
  display: inline-block;
  font-family: 'Barlow Condensed', sans-serif;
  font-size: .78rem; font-weight: 700;
  letter-spacing: .22em; text-transform: uppercase;
  color: var(--red); border: 1px solid var(--red);
  padding: 6px 14px; margin-bottom: 24px;
  animation: fadeUp .6s ease both;
}

/* Heading */
h1 {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(3.8rem, 10vw, 8rem);
  line-height: .95; letter-spacing: .02em;
  animation: fadeUp .7s ease .1s both;
}
.fill  { color: var(--white); }
.outline { -webkit-text-stroke: 2px var(--red); color: transparent; }

.hero-sub {
  font-size: clamp(.95rem, 2vw, 1.1rem);
  font-weight: 300; color: var(--silver);
  max-width: 540px; line-height: 1.75;
  margin-top: 24px;
  animation: fadeUp .7s ease .2s both;
}

.hero-actions {
  display: flex; flex-wrap: wrap; gap: 14px;
  margin-top: 36px;
  animation: fadeUp .7s ease .3s both;
}

/* Stats */
.hero-stats {
  display: flex; flex-wrap: wrap; gap: 40px;
  padding-top: 36px;
  border-top: 1px solid rgba(255,255,255,.1);
  animation: fadeUp .7s ease .4s both;
}
.stat { display: flex; flex-direction: column; gap: 4px; }
.stat-num {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 2.8rem; color: var(--red); line-height: 1;
}
.plus { font-size: 1.8rem; }
.stat-label {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: .75rem; font-weight: 700;
  letter-spacing: .12em; text-transform: uppercase;
  color: var(--silver);
}

/* BG flame */
.hero-bg-flame {
  position: absolute; right: 4%; top: 50%; transform: translateY(-50%);
  font-size: clamp(10rem, 22vw, 22rem);
  opacity: .06; user-select: none; pointer-events: none;
  animation: pulse 3s ease-in-out infinite;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(28px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes pulse {
  0%,100% { opacity: .06; transform: translateY(-50%) scale(1);   }
  50%      { opacity: .10; transform: translateY(-50%) scale(1.05);}
}

@media (max-width: 600px) {
  .hero-bg-flame { display: none; }
  .hero-stats { gap: 24px; }
  .stat-num { font-size: 2.2rem; }
}
</style>
